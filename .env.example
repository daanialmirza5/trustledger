# --- Database ---
# Local dev default is SQLite (zero setup). For a production-style run,
# point this at Postgres instead — see docker-compose.yml and
# docs/architecture.md for the migration path.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://trustledger:trustledger@localhost:5432/trustledger"

# --- Auth ---
# HMAC secret used to sign session cookies. Generate your own for anything
# beyond local dev, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-insecure-secret-change-me"

# --- AI providers (all optional) ---
# TrustLedger works with none of these set — it falls back to a fully
# deterministic mock narrator. Set any one of these to enable a real LLM.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
